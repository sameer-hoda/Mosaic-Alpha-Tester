GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: pin the Me chat JID explicitly (validated at launch, never guessed)
MECHAT_JID=""

# Optional: legacy owner hint when the pairing store is unreadable
OWNER_PHONE_NUMBER=""

# Optional: where SQLite databases, mechat.json and bridge_token live
STORE_DIR="./store"

# Optional: how many days of chat history to keep (default 30)
NEMBU_HISTORY_DAYS="30"
# Legacy: MOSAIC_HISTORY_DAYS still supported as fallback
# MOSAIC_HISTORY_DAYS="30"

# Optional: override database paths (default: $STORE_DIR/*.db)
MESSAGES_DB_PATH="./store/messages.db"
WHATSAPP_DB_PATH="./store/whatsapp.db"

# Optional: shared token for the loopback send API (generated when unset and
# written to $STORE_DIR/bridge_token)
BRIDGE_TOKEN=""

# Optional: loopback send API endpoint used by the Python worker
WA_API_URL="http://127.0.0.1:8090/api/send"

# Optional: timezone for timestamps (IST for alpha testers)
GEMINI_MODEL_QA="gemini-3.5-flash"

TZ="Asia/Kolkata"
